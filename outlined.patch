+// Keep this loop separate to limit its effect on code generation for the general case.
+static EIGEN_DONT_INLINE void Col2im2x2Stride2(const float* data_col, int64_t channels,
+                                               int64_t output_h, int64_t output_w, float* data_im) {
+  const int64_t plane = output_h * output_w;
+  const int64_t width = 2 * output_w;
+  // Each output has one input value. Interleave the four column planes so
+  // adjacent output values are written together, without an output read.
+  for (int64_t c = 0; c < channels; ++c) {
+    for (int64_t h = 0; h < output_h; ++h) {
+      const float* src = data_col + c * 4 * plane + h * output_w;
+      float* dst = data_im + c * 4 * plane + h * 2 * width;
+      for (int64_t w = 0; w < output_w; ++w) {
+        // Keep the addition to positive zero for signed-zero behavior.
+        dst[2 * w] = 0.0f + src[w];
+        dst[2 * w + 1] = 0.0f + src[plane + w];
+        dst[width + 2 * w] = 0.0f + src[2 * plane + w];
+        dst[width + 2 * w + 1] = 0.0f + src[3 * plane + w];
+      }
+    }
+  }
+}
